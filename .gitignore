# 浏览器登录状态（本地敏感数据）
playwright-profile/

# 事件日志与页面片段（含用户数据）
event-captures/
validation/event-captures/

# Vue
web-src/node_modules/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Playwright Chromium（由 run.bat / ensure_env.py 下载到项目内）
.playwright-browsers/

# 配置保存时的临时文件
*.json.tmp

# 本机场控配置（仓库只提交 config/app.example.json）
/config/app.json

# 本地小说库（含小说正文与进度）
/data/

# 本地代理协作记录
/AGENTS.md
/HANDOFF.md
/PROJECT.md
/TASKS.md
/多 Agent 项目协作.md

# IDE
.idea/
.vscode/

# 系统文件
Thumbs.db
.DS_Store
validation/decode-dumps/
validation/ws-dumps/

# 本地运行日志（可能含用户昵称与房间信息）
logs/
